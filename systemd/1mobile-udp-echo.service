[Unit]
Description=1Mobile UDP echo responder for tunnel RTT probes
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/1mobile-web-v13/udp_echo.py
Environment=ECHO_HOST=0.0.0.0
Environment=ECHO_PORT=5355
DynamicUser=yes
NoNewPrivileges=true
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
