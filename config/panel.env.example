# Optional environment overrides for /etc/systemd/system/1mobile-panel.service
# Copy the lines you need into an override:
#   systemctl edit 1mobile-panel
# Then add:
#   [Service]
#   Environment="LISTEN=0.0.0.0"
#   Environment="PORT=9443"
#   Environment="PANEL_DATA=/etc/1mobile-panel"
#   Environment="AWG_BIN=/usr/local/bin/awg"
LISTEN=0.0.0.0
PORT=9443
PANEL_DATA=/etc/1mobile-panel
AWG_BIN=/usr/local/bin/awg
